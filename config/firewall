#!/bin/bash

# =================================================================
# HOKAGE AUTO SECURITY INSTALLER KUSTOM
# Deskripsi: Mengamankan server dengan UFW dan Fail2Ban otomatis.
# =================================================================

# Warna untuk tampilan layar (Output Terminal)
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
NC="\033[0m" # No Color

# Bersihkan layar sebelum memulai
clear

echo -e "${YELLOW}=====================================================${NC}"
echo -e "${YELLOW}       HOKAGE AUTOMATIC SECURITY INSTALLER KUSTOM     ${NC}"
echo -e "${YELLOW}=====================================================${NC}"
echo ""

# [1/4] Menyiapkan & Mengunduh Paket
echo -e "${YELLOW}[1/4] Menyiapkan, memperbarui, dan menginstal paket (UFW & Fail2Ban)...${NC}"
apt update -y
apt install -y ufw fail2ban

# Tambahkan jeda 3 detik di sini untuk menghindari xtables lock!
sleep 3
echo """

# [2/4] Mengkonfigurasi & Membuka Port Firewall (UFW)
echo -e "${YELLOW}[2/4] Mengkonfigurasi port UFW (SSH, HTTP/S, Gateway/UDP)...${NC}"
# Port SSH Kustom & Standar
ufw allow 22/tcp
ufw allow 2222/tcp
ufw allow 2223/tcp
# Port Web (HTTP & HTTPS)
ufw allow 80/tcp
ufw allow 443/tcp
# Port UDP Kustom (Range 7100 sampai 7300)
ufw allow 7100:7300/udp

# Mengaktifkan UFW tanpa konfirmasi y/n (--force)
ufw --force enable
echo ""

# [3/4] Mengkonfigurasi Fail2Ban
echo -e "${YELLOW}[3/4] Menulis isi file konfigurasi jail.local untuk Fail2Ban...${NC}"
cat <<EOF > /etc/fail2ban/jail.local
[sshd]
enabled = true
port = 22,2222,2223
logpath = /var/log/auth.log
maxretry = 3
bantime = 3600
EOF
echo ""

# [4/4] Menerapkan Konfigurasi dan Menyalakan Layanan
echo -e "${YELLOW}[4/4] Menerapkan konfigurasi dan menyalakan layanan keamanan...${NC}"
systemctl restart fail2ban
systemctl enable fail2ban
echo ""

# Selesai
echo -e "${GREEN}======================================================${NC}"
echo -e "${GREEN} INSTALASI SELESAI! SERVER SEKARANG DILINDUNGI PENUH  ${NC}"
echo -e "${GREEN}======================================================${NC}"
