#!/bin/bash
# ==========================================
#   ZIVPN ULTIMATE INSTALLER (FIXED EDITION)
#   Fixed by: Assistant (Auto-Sync, Anti-Reboot, Auto-Cleanup & Menu)
#   For Architecture: AMD64 / x86_64
# ==========================================

# --- WARNA ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

clear
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "       ZIVPN AUTO-INSTALLER (AMD64 FIXED)       "
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# ==========================================
#  1. PRE-INSTALL: CEK & HAPUS VERSI LAMA
# ==========================================
echo -e "\n${YELLOW}[1/9] Membersihkan Sistem...${NC}"

if [[ -f /etc/systemd/system/zivpn.service ]] || [[ -d /etc/zivpn ]]; then
    echo -e "   ⚠️  Instalasi lama ditemukan. Menghapus..."
    systemctl stop zivpn >/dev/null 2>&1
    systemctl disable zivpn >/dev/null 2>&1
    rm -f /etc/systemd/system/zivpn.service
    rm -rf /etc/zivpn
    rm -f /usr/local/sbin/zivpn-menu
    rm -f /usr/local/sbin/xp-zivpn
    rm -f /usr/local/bin/zivpn-sync
    rm -f /usr/local/bin/zivpn
    
    sed -i '/xp-zivpn/d' /var/spool/cron/crontabs/root 2>/dev/null
    sed -i '/limit-quota/d' /var/spool/cron/crontabs/root 2>/dev/null
    
    systemctl daemon-reload
    echo -e "   ✅ Bersih."
else
    echo -e "   ✅ Sistem bersih."
    rm -f /usr/local/bin/zivpn
fi

# ==========================================
#  2. INSTALL DEPENDENCIES
# ==========================================
echo -e "\n${GREEN}[2/9] Menginstall Paket Pendukung...${NC}"
apt-get update -y >/dev/null 2>&1
apt-get install -y wget curl jq net-tools cron bc chrony iptables iptables-persistent netfilter-persistent openssl >/dev/null 2>&1

systemctl enable chrony >/dev/null 2>&1
systemctl start chrony >/dev/null 2>&1

# ==========================================
#  3. INSTALL CORE ZIVPN
# ==========================================
echo -e "\n${GREEN}[3/9] Mengunduh Core ZiVPN (AMD64)...${NC}"
mkdir -p /etc/zivpn

curl -sSL "https://github.com/zahidbd2/udp-zivpn/releases/download/udp-zivpn_1.4.9/udp-zivpn-linux-amd64" -o /usr/local/bin/zivpn

if [ ! -s /usr/local/bin/zivpn ]; then
    echo -e "\n${RED}GAGAL: File binary gagal diunduh atau berukuran 0 byte!${NC}"
    echo -e "Sistem membatalkan instalasi. Silakan periksa koneksi internet VPS Anda."
    exit 1
fi

chmod +x /usr/local/bin/zivpn
echo -e "   ✅ Unduhan berhasil diverifikasi."

cat > /etc/zivpn/config.json <<EOF
{
  "listen": ":5667",
  "cert": "/etc/zivpn/zivpn.crt",
  "key": "/etc/zivpn/zivpn.key",
  "obfs": "zivpn",
  "auth": {
    "mode": "passwords",
    "config": ["zi"]
  }
}
EOF
chmod 644 /etc/zivpn/config.json

openssl req -new -newkey rsa:4096 -days 365 -nodes -x509 -subj "/C=US/ST=California/L=Los Angeles/O=Example Corp/OU=IT Department/CN=zivpn" -keyout "/etc/zivpn/zivpn.key" -out "/etc/zivpn/zivpn.crt" >/dev/null 2>&1

sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1

# ==========================================
#  4. SCRIPT AUTO-SYNC
# ==========================================
echo -e "${GREEN}[4/9] Memasang Auto-Sync User (Zivpn-Sync)...${NC}"
cat > /usr/local/bin/zivpn-sync << 'EOF'
#!/bin/bash
CONFIG_FILE="/etc/zivpn/config.json"
if [ ! -f "$CONFIG_FILE" ]; then exit 0; fi

while IFS=: read -r username _ uid _ _ _ _; do
    if [[ "$uid" -ge 1000 && "$username" != "nobody" && "$username" != "zi" ]]; then
        if ! jq -e --arg u "$username" '.auth.config | index($u)' "$CONFIG_FILE" >/dev/null 2>&1; then
             jq --arg u "$username" '.auth.config += [$u]' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
             mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
        fi
    fi
done < /etc/passwd
EOF
chmod +x /usr/local/bin/zivpn-sync

# ==========================================
#  5. SYSTEMD SERVICE
# ==========================================
echo -e "${GREEN}[5/9] Konfigurasi Systemd Service...${NC}"
cat <<EOF > /etc/systemd/system/zivpn.service
[Unit]
Description=zivpn VPN Server
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/zivpn
ExecStartPre=/usr/local/bin/zivpn-sync
ExecStart=/usr/local/bin/zivpn server -c /etc/zivpn/config.json
Restart=always
RestartSec=3
Environment=ZIVPN_LOG_LEVEL=info
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload

# ==========================================
#  6. IPTABLES ROUTING
# ==========================================
echo -e "${GREEN}[6/9] Memasang Routing Iptables (REDIRECT)...${NC}"
iptables -t nat -D PREROUTING -i $(ip -4 route ls|grep default|grep -Po '(?<=dev )(\S+)'|head -1) -p udp --dport 6000:19999 -j DNAT --to-destination :5667 2>/dev/null

iptables -t nat -A PREROUTING -p udp --dport 6000:19999 -j REDIRECT --to-ports 5667
iptables -I INPUT -p udp --dport 5667 -j ACCEPT
iptables -I INPUT -p udp -m multiport --dports 6000:19999 -j ACCEPT

netfilter-persistent save >/dev/null 2>&1
iptables-save > /etc/iptables.up.rules

# ==========================================
#  7. MEMBUAT MENU UTILITY & STARTING
# ==========================================
echo -e "\n${GREEN}[7/9] Membuat Menu Utility & Menjalankan Service...${NC}"

# ---- INJEKSI FILE zivpn-menu ----
cat > /usr/local/sbin/zivpn-menu << 'EOF'
#!/bin/bash
# ==========================================
#   ZIVPN MENU UTILITY (Ultimate Monitor)
#   Fitur: CRUD, Sync, Advanced Monitor View
# ==========================================

# --- KONFIGURASI WARNA & BACKGROUND ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'
WHITE='\033[1;37m'
BOLD='\033[1m'
COLOR_BORDER='\033[38;5;93m'
BG_MAIN='\033[48;5;88m'
y='\033[1;33m' #yellow

print_yellow() {
    echo -e "${y}$1${NC}"
}

CONFIG_FILE="/etc/zivpn/config.json"
DB_FILE="/etc/ssh/.ssh.db"

if [ ! -f "$CONFIG_FILE" ]; then
    echo -e "${RED}Error: ZiVPN belum terinstall atau file config hilang!${NC}"
    exit 1
fi

# Info Server (Cache global)
domain=$(cat /etc/xray/domain 2>/dev/null || echo "IP-Only")
IP=$(curl -sS ipv4.icanhazip.com 2>/dev/null)
UDP_ZIVPN=$(grep -o '"listen": *"[^"]*"' /etc/zivpn/config.json 2>/dev/null | cut -d'"' -f4 | sed 's/://g' | sed 's/0.0.0.0//g' || echo "5667")
PUB=$(cat /etc/slowdns/server.pub 2>/dev/null || echo "Not Set")
NS=$(cat /etc/xray/dns 2>/dev/null || echo "Not Set")
ISP=$(cat /root/.info/.isp 2>/dev/null || echo "Unknown")
CITY=$(cat /root/.info/.city 2>/dev/null || echo "Unknown")

clear
print_yellow "════════════════════════════════════════════"
echo -e "${GREEN}          ZIVPN USER MANAGEMENT          ${NC}"
print_yellow "      ═════════════════════════════      "
echo -e " [1] Tambah User ZiVPN"
echo -e " [2] Hapus User ZiVPN"
echo -e " [3] Edit Password User ZiVPN"
echo -e " [4] Lihat Daftar User & Detail (Monitor)"
echo -e " [5] Cek Koneksi IP Aktif ZiVPN"
echo -e " [6] Sync Semua User SSH ke ZiVPN"
echo -e " [x] Keluar"
print_yellow "════════════════════════════════════════════"
read -p " Pilih Menu [1-6 / x] : " option

case $option in
    1)
        clear
        echo -e "${CYAN}=== TAMBAH USER ZIVPN ===${NC}"
        read -p "Username: " user
        if jq -e --arg u "$user" '.auth.config | index($u)' "$CONFIG_FILE" >/dev/null 2>&1; then
            echo -e "${RED}User $user sudah ada!${NC}"
        else
            jq --arg u "$user" '.auth.config += [$u]' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
            mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
            systemctl restart zivpn
            echo -e "${GREEN}Berhasil menambah user: $user${NC}"
        fi
        sleep 2
        /usr/local/sbin/zivpn-menu
        ;;
    2)
        clear
        echo -e "${CYAN}=== HAPUS USER ZIVPN ===${NC}"
        read -p "Username: " user
        if jq -e --arg u "$user" '.auth.config | index($u)' "$CONFIG_FILE" >/dev/null 2>&1; then
            jq --arg u "$user" '.auth.config -= [$u]' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
            mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
            systemctl restart zivpn
            echo -e "${GREEN}Berhasil menghapus user: $user${NC}"
        else
            echo -e "${RED}User $user tidak ditemukan!${NC}"
        fi
        sleep 2
        /usr/local/sbin/zivpn-menu
        ;;
    3)
        clear
        echo -e "${CYAN}=== EDIT PASSWORD ZIVPN ===${NC}"
        echo -e "${YELLOW}Catatan: ZiVPN menggunakan daftar password (username). Fitur ini menghapus user lama dan membuat user baru.${NC}"
        read -p "Username Lama: " old_user
        if jq -e --arg u "$old_user" '.auth.config | index($u)' "$CONFIG_FILE" >/dev/null 2>&1; then
            read -p "Username/Password Baru: " new_user
            jq --arg u "$old_user" '.auth.config -= [$u]' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
            jq --arg u "$new_user" '.auth.config += [$u]' "${CONFIG_FILE}.tmp" > "${CONFIG_FILE}"
            rm -f "${CONFIG_FILE}.tmp"
            systemctl restart zivpn
            echo -e "${GREEN}Berhasil mengubah $old_user menjadi $new_user${NC}"
        else
            echo -e "${RED}User $old_user tidak ditemukan!${NC}"
        fi
        sleep 2
        /usr/local/sbin/zivpn-menu
        ;;
    4)
        clear
        echo -e "${COLOR_BORDER}╭──────────────────────────────────────────────────────╮${NC}"
        printf "${COLOR_BORDER}│${BG_MAIN}${BOLD}${WHITE}%-54s${NC}${COLOR_BORDER}│${NC}\n" "        HOKAGE LEGEND: ZIVPN USER MANAGER              "
        echo -e "${COLOR_BORDER}╰──────────────────────────────────────────────────────╯${NC}"
        echo -e "${COLOR_BORDER}╭────┬──────────────────────┬─────────────┬────────────╮${NC}"
        echo -e "${COLOR_BORDER}│ NO │ USERNAME             │ EXPIRED     │ STATUS     │${NC}"
        echo -e "${COLOR_BORDER}├────┼──────────────────────┼─────────────┼────────────┤${NC}"

        zivpn_users=$(jq -r '.auth.config[]' "$CONFIG_FILE")
        user_array=()
        i=0

        for username in $zivpn_users; do
            user_array+=("$username")
            i=$((i+1))
            
            # Cek Masa Aktif dari sistem
            exp_str=$(chage -l "$username" 2>/dev/null | grep "Account expires" | cut -d: -f2)
            if [[ -z "$exp_str" || "$exp_str" == *"never"* ]]; then 
                sisa="Unlimited"
            else
                exp_date=$(date -d "$exp_str" +%s 2>/dev/null)
                today=$(date +%s)
                if [[ -n "$exp_date" ]]; then
                    diff=$(( (exp_date - today) / 86400 ))
                    if [[ $diff -lt 0 ]]; then sisa="${RED}Expired${NC}"; else sisa="${GREEN}${diff} Hari${NC}"; fi
                else
                    sisa="${YELLOW}Unknown${NC}"
                fi
            fi
            
            # Cek Status ON/OFF 
            if pgrep -u "$username" sshd > /dev/null 2>&1 || pgrep -u "$username" dropbear > /dev/null 2>&1; then
                 status="${GREEN}ON${NC}"
            else
                 status="${RED}OFF${NC}"
            fi
            
            printf "${COLOR_BORDER}│ %-2s │ %-20s │ %-19b │ %-18b │${NC}\n" "$i" "${username:0:20}" "$sisa" "$status"
        done
        echo -e "${COLOR_BORDER}╰────┴──────────────────────┴─────────────┴────────────╯${NC}"

        echo -e ""
        read -p " Pilih Nomor User [1-$i] untuk detail, atau [x] Kembali: " choice
        
        if [[ "$choice" == "x" || "$choice" == "X" ]]; then
            /usr/local/sbin/zivpn-menu
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
            selected_user="${user_array[$((choice-1))]}"
            
            # Ambil data tambahan dari database .ssh.db (jika ada)
            DB_DATA=$(awk -v usr="$selected_user" '$1 == "#ssh#" && $2 == usr {print $0}' "$DB_FILE" 2>/dev/null | tail -n 1)
            DB_DATA=$(echo "$DB_DATA" | tr -d '\r')
            Pass=$(echo "$DB_DATA" | awk '{print $3}')
            [ -z "$Pass" ] && Pass="???"
            Quota=$(echo "$DB_DATA" | awk '{print $4}')
            [ -z "$Quota" ] && Quota="0"
            iplimit=$(echo "$DB_DATA" | awk '{print $5}')
            [ -z "$iplimit" ] && iplimit="2"

            exp_str=$(chage -l "$selected_user" 2>/dev/null | grep "Account expires" | cut -d: -f2)
            if [[ -z "$exp_str" || "$exp_str" == *"never"* ]]; then
                exp_date_fmt="Unlimited"
            else
                exp_date_fmt=$(date -d "$exp_str" +"%d %b, %Y" 2>/dev/null || echo "Unlimited")
            fi
            
            clear
            echo ""
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "🔵 DETAIL AKUN ZIVPN & SSH 🔵" 
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "➤ Domain        : $domain" 
            echo -e "➤ Username      : $selected_user" 
            echo -e "➤ Password      : $Pass" 
            echo -e "➤ ZIVPN Token   : $selected_user" 
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "➤ Limit Ip      : $iplimit Device" 
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "➤ IP            : $IP" 
            echo -e "➤ Limit Quota   : $Quota GB" 
            echo -e "➤ Host Slowdns  : ${NS}" 
            echo -e "➤ Isp           : $ISP" 
            echo -e "➤ Location      : $CITY" 
            echo -e "➤ Port OpenSSH  : 443, 80, 22" 
            echo -e "➤ Port DNS      : 443, 53 ,22 " 
            echo -e "➤ Port SSH UDP  : 1-65535" 
            echo -e "➤ Port ZIVPN    : $UDP_ZIVPN" 
            echo -e "➤ Port Dropbear : 443, 109" 
            echo -e "➤ Port SSH WS   : 80, 8080, 8880, 2082" 
            echo -e "➤ Port OVPN SSL : 443" 
            echo -e "➤ Port OVPN TCP : 443, 1194" 
            echo -e "➤ Port OVPN UDP : 2200" 
            echo -e "➤ BadVPN UDP    : 7100, 7300, 7300" 
            echo -e "➤ Pub Key       : ${PUB}" 
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "𝗣𝗮𝘆𝗹𝗼𝗮𝗱 𝗪𝗲𝗯𝘀𝗼𝗰𝗸𝗲𝘁 :\nGET / HTTP/1.1[crlf]host: $domain[crlf]Upgrade: Websocket[crlf][crlf]" 
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "𝗣𝗮𝘆𝗹𝗼𝗮𝗱 𝗦𝗦𝗟 / 𝗧𝗟𝗦 : \nGET wss://BUG.COM/ HTTP/1.1[crlf]Host: $domain[crlf]Upgrade: websocket[crlf][crlf]" 
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "OVPN Download    : https://$domain:81/" 
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "Berakhir Pada      : $exp_date_fmt" 
            echo -e "\033[1;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m" 
            echo -e "\033[5m\033[35mTERIMAKASIH \033[34mSUDAH BERBELANJA \033[31mDI HOKAGE LEGEND\033[0m" 
            
            echo ""
            read -n 1 -s -r -p "Tekan sembarang tombol untuk kembali..."
            /usr/local/sbin/zivpn-menu
        else
            echo -e "${RED}Pilihan tidak valid!${NC}"
            sleep 1
            /usr/local/sbin/zivpn-menu
        fi
        ;;
    5)
        clear
        echo -e "${CYAN}=== CEK KONEKSI IP AKTIF ZIVPN ===${NC}"
        echo -e "Menampilkan koneksi aktif pada port ZiVPN ($UDP_ZIVPN/UDP)..."
        echo -e "---------------------------------------------------"
        netstat -anup | grep $UDP_ZIVPN | grep zivpn | awk '{print $5}' | cut -d: -f1 | sort | uniq -c | awk '{print "IP Client: " $2 " - (" $1 " Koneksi)"}'
        echo -e "---------------------------------------------------"
        echo -e "Catatan: ZiVPN tidak mencatat username di tabel netstat, hanya IP yang terhubung."
        echo -e "\nTekan Enter untuk kembali..."
        read -r
        /usr/local/sbin/zivpn-menu
        ;;
    6)
        clear
        echo -e "${CYAN}=== SYNC USER SSH KE ZIVPN ===${NC}"
        echo -e "Membaca data user SSH sistem..."
        
        while IFS=: read -r username _ uid _ _ _ _; do
            if [[ "$uid" -ge 1000 && "$username" != "nobody" && "$username" != "zi" ]]; then
                if ! jq -e --arg u "$username" '.auth.config | index($u)' "$CONFIG_FILE" >/dev/null 2>&1; then
                    jq --arg u "$username" '.auth.config += [$u]' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
                    mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
                    echo -e " ${GREEN}+ Tersinkronisasi: $username${NC}"
                fi
            fi
        done < /etc/passwd
        
        systemctl restart zivpn
        echo -e "\n${GREEN}Sinkronisasi selesai!${NC}"
        sleep 2
        /usr/local/sbin/zivpn-menu
        ;;
    x)
        exit 0
        ;;
    *)
        echo -e "${RED}Pilihan tidak valid!${NC}"
        sleep 2
        /usr/local/sbin/zivpn-menu
        ;;
esac
EOF
# ---- AKHIR INJEKSI FILE zivpn-menu ----

chmod +x /usr/local/sbin/zivpn-menu

systemctl enable zivpn >/dev/null 2>&1
systemctl restart zivpn >/dev/null 2>&1

PORT_ZIVPN=$(grep -o '"listen": *"[^"]*"' /etc/zivpn/config.json | cut -d'"' -f4 | sed 's/://g' | sed 's/0.0.0.0//g')
[ -z "$PORT_ZIVPN" ] && PORT_ZIVPN="5667"

if [ -f "/etc/systemd/system/udp-custom.service" ]; then
    sed -i "s|server -exclude .*|server -exclude 22,53,68,$PORT_ZIVPN|g" /etc/systemd/system/udp-custom.service
    systemctl daemon-reload
    systemctl restart udp-custom
fi

# ==========================================
#  8. CLEANUP FILE SISA INSTALASI
# ==========================================
echo -e "${GREEN}[8/9] Membersihkan file sisa instalasi...${NC}"
rm -f zi.sh zivpn zivpn.* update 2>/dev/null
echo -e "   ✅ File sampah berhasil dihapus."

STATUS=$(systemctl is-active zivpn)

clear
echo "============================================"
echo "      ✅ INSTALLASI ZIVPN SELESAI ✅"
echo "============================================"
if [[ "$STATUS" == "active" ]]; then
    echo -e " Status Service : ${GREEN}RUNNING (AMAN)${NC}"
else
    echo -e " Status Service : ${RED}ERROR / STOPPED${NC}"
    echo -e " Cek log dengan : journalctl -u zivpn -n 20"
fi
echo "============================================"
echo " - Config Path  : /etc/zivpn/config.json"
echo " - Binary Path  : /usr/local/bin/zivpn"
echo " - Port ZiVPN   : $PORT_ZIVPN"
echo " - Menu Utility : zivpn-menu"
echo " - Auto-Sync    : ACTIVE (Anti-Reset)"
echo " - Iptables     : REDIRECT (Anti-Reboot)"
echo " - Auto-Cleanup : SUCCESS"
echo "============================================"
