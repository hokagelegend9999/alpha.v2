#!/bin/bash

# Konfigurasi Warna untuk Tampilan
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${YELLOW}======================================================${NC}"
echo -e "${GREEN}   AUTO INSTALLER UFW & FAIL2BAN HOKAGE STORE         ${NC}"
echo -e "${YELLOW}======================================================${NC}"
echo ""

echo -e "${YELLOW}[1/6] Memperbarui repository dan menginstal paket...${NC}"
# Mencegah pop-up interaktif saat instalasi paket
DEBIAN_FRONTEND=noninteractive apt-get update -y
DEBIAN_FRONTEND=noninteractive apt-get install ufw fail2ban -y

echo -e "${YELLOW}[2/6] Membersihkan layanan yang bentrok...${NC}"
# Mematikan netfilter-persistent agar tidak menimpa UFW saat reboot
systemctl stop netfilter-persistent 2>/dev/null
systemctl disable netfilter-persistent 2>/dev/null
systemctl stop iptables-persistent 2>/dev/null
systemctl disable iptables-persistent 2>/dev/null

echo -e "${YELLOW}[3/6] Mengatur aturan dasar dan membuka port...${NC}"
# Mereset aturan lama (ini akan mematikan UFW sementara)
ufw --force reset
ufw default deny incoming
ufw default allow outgoing

# Membuka port yang dibutuhkan (Ditambah UDP agar Xray/SSHWS stabil)
ufw allow 22/tcp
ufw allow 2222/tcp
ufw allow 2223/tcp
ufw allow 80/tcp
ufw allow 80/udp
ufw allow 443/tcp
ufw allow 443/udp
ufw allow 7100:7300/udp

echo -e "${YELLOW}[4/6] Mengizinkan Forwarding untuk VPN/Tunneling...${NC}"
# Mencegah UFW memblokir routing VPN pelanggan
sed -i 's/DEFAULT_FORWARD_POLICY="DROP"/DEFAULT_FORWARD_POLICY="ACCEPT"/g' /etc/default/ufw

echo -e "${YELLOW}[5/6] Mengaktifkan Firewall (Anti-Mati saat Reboot)...${NC}"
# Mengaktifkan UFW tanpa prompt y/n
ufw --force enable
# Memastikan sistem membaca UFW selalu aktif saat startup
sed -i 's/ENABLED=no/ENABLED=yes/g' /etc/ufw/ufw.conf

# Mendaftarkan UFW ke sistem WAJIB dilakukan setelah proses 'reset'
systemctl unmask ufw
systemctl enable ufw
systemctl start ufw

echo -e "${YELLOW}[6/6] Mengonfigurasi Fail2Ban (Anti-Bruteforce SSH)...${NC}"
cat > /etc/fail2ban/jail.local <<EOF
[sshd]
enabled = true
port = 22,2222,2223
logpath = /var/log/auth.log
maxretry = 3
bantime = 3600
EOF

systemctl enable fail2ban
systemctl restart fail2ban

echo ""
echo -e "${GREEN}======================================================${NC}"
echo -e "${GREEN} INSTALASI SELESAI! SERVER SEKARANG DILINDUNGI PENUH  ${NC}"
echo -e "${GREEN}======================================================${NC}"
echo -e "${YELLOW}Status Firewall Saat Ini:${NC}"
ufw status
