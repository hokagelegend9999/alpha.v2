#!/bin/bash
clear
y='\033[1;33m' #yellow
BGX="\033[42m"
CYAN="\033[96m"
z="\033[96m"
f="\033[1;97;41m"
RED='\033[0;31m'
NC='\033[0m'
gray="\e[1;30m"
Blue="\033[0;34m"
green='\033[0;32m'
grenbo="\e[92;1m"
purple="\033[1;95m"
YELL='\033[0;33m'
r='\033[0;31m'

# Fungsi untuk garis kuning solid (Sangat Ringan)
print_yellow() {
    echo -e "${y}$1${NC}"
}

IPVPS=$(curl -s ipv4.icanhazip.com)
ISP=$(cat /root/.info/.isp 2>/dev/null || echo "Unknown ISP")
CITY=$(cat /root/.info/.city 2>/dev/null || echo "Unknown City")
NS=$(cat /etc/xray/dns 2>/dev/null)
domain=$(cat /etc/xray/domain 2>/dev/null)
RAM=$(free -m | awk 'NR==2 {print $2}')
LOADCPU=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1"%"}')
MODEL=$(cat /etc/os-release | grep -w PRETTY_NAME | head -n1 | sed 's/=//g' | sed 's/"//g' | sed 's/PRETTY_NAME//g')
CORE=$(grep -c cpu[0-9] /proc/stat)
DATEVPS=$(date +'%d-%m-%Y')
TIMEZONE=$(date +'%H-%M-%S')
SERONLINE=$(uptime -p | cut -d " " -f 2-10000)

clear
MYIP=$(curl -sS ipv4.icanhazip.com)
echo ""

izinsc="https://raw.githubusercontent.com/hokagelegend9999/ijin/refs/heads/main/alpha"
USER_DATA=$(curl -s ${izinsc} | grep $MYIP)
username=$(echo "$USER_DATA" | awk '{print $2}')
id_telegram=$(echo "$username" | cut -d '|' -f 1)
user_script=$(echo "$username" | cut -d '|' -f 2)
valid=$(echo "$USER_DATA" | awk '{print $3}')
echo "$username" >/usr/bin/user
echo "$valid" >/usr/bin/e
oid=$(cat /usr/bin/ver 2>/dev/null)
exp=$valid
today=$(date +"%Y-%m-%d")
d1=$(date -d "$valid" +%s)
d2=$(date -d "$today" +%s)
certifacate=$(((d1 - d2) / 86400))
blink_red='\033[5;31m'
blink_green='\033[5;32m'

if [[ "$d1" -ge "$d2" ]]; then
    if [[ "$certifacate" -le 7 ]]; then
        sts="${y}(${NC}${certifacate} Hari${y}) ${blink_red}(Active)${NC}"
    else
        sts="${y}(${NC}${certifacate} Hari${y}) ${blink_green}(Active)${NC}"
    fi
else
    sts="${y}(${NC}0 Hari${y}) ${blink_red}(Expired)${NC}"
fi
tram=$( free -m | awk 'NR==2 {print $2}' )
uram=$( free -m | awk 'NR==2 {print $3}' )
fram=$( free -m | awk 'NR==2 {print $4}' )

clear
cek_service() {
    if systemctl is-active --quiet "$1"; then
        echo -e "${green}ON ${NC}"
    else
        echo -e "${RED}OFF${NC}"
    fi
}

# === DETEKSI INSTALASI CERDAS ===
is_zivpn=false
is_udp=false
is_slowdns=false

if [ -f "/etc/systemd/system/zivpn.service" ]; then is_zivpn=true; fi
if [ -f "/etc/systemd/system/udp-custom.service" ]; then is_udp=true; fi
if [ -f "/etc/systemd/system/server-sldns.service" ] || [ -f "/etc/systemd/system/client-sldns.service" ]; then is_slowdns=true; fi
# ================================

ssh_ws_status=$(systemctl is-active --quiet ws && echo -e "${green}ON ${NC}" || echo -e "${RED}OFF${NC}")
status_ssh=$(cek_service ssh)
status_haproxy=$(cek_service haproxy)
status_xray=$(cek_service xray)
status_nginx=$(cek_service nginx)
status_dropbear=$(cek_service dropbear)
status_udp_custom=$(cek_service udp-custom)
status_zivpn=$(cek_service zivpn)

if systemctl is-active --quiet server-sldns; then
    status_slowdns="${green}ON ${NC}"
elif systemctl is-active --quiet client-sldns; then
    status_slowdns="${green}ON ${NC}"
else
    status_slowdns="${RED}OFF${NC}"
fi

vla=$(grep -E "^#& " "/etc/xray/config.json" 2>/dev/null | cut -d ' ' -f 2 | sort | uniq | wc -l)
vma=$(grep -E "^### " "/etc/xray/config.json" 2>/dev/null | cut -d ' ' -f 2 | sort | uniq | wc -l)
trb=$(grep -E "^#! " "/etc/xray/config.json" 2>/dev/null | cut -d ' ' -f 2 | sort | uniq | wc -l)
ssa=$(grep -E "^#ss# " "/etc/xray/config.json" 2>/dev/null | cut -d ' ' -f 2 | sort | uniq | wc -l)
ssh1=$(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | wc -l)

pad_ssh1=$(printf "%-3s" "$ssh1")
pad_vma=$(printf "%-3s" "$vma")
pad_vla=$(printf "%-3s" "$vla")
pad_trb=$(printf "%-3s" "$trb")
pad_ssa=$(printf "%-3s" "$ssa")

echo -e " "
print_yellow "══════════════════════════════════════════════════════════"
echo -e "                ${y}AUTOSCRIPT VPS PREMIUM${NC}                "
print_yellow "           ══════════════════════════════════════════      "
echo -e " $NC$y System OS    $Blue=$NC $MODEL${NC}"
echo -e " $NC$y ISP          $Blue=$NC $ISP${NC}"
echo -e " $NC$y City         $Blue=$NC $CITY${NC}"
echo -e " $NC$y Uptime       $Blue=$NC $SERONLINE${NC}"
echo -e " $NC$y Expired      $Blue=$NC $exp $sts${NC}"
echo -e " $NC$y Domain       $Blue=$NC $domain${NC}"
print_yellow "══════════════════════════════════════════════════════════"
echo -e "              ${CYAN}INFORMATION ACCOUNT ON VPS${NC}              "
print_yellow "══════════════════════════════════════════════════════════"
echo -e " $NC$z SSH/OVPN/UDP $y=$NC $pad_ssh1 $NC${y}│$NC $z USER $y=$NC $user_script"
echo -e " $NC$z VMESS/WS/TLS $y=$NC $pad_vma $NC${Blue}│$NC $z IPV4 $y=$NC $IPVPS${NC}"
echo -e " $NC$z VLESS/WS/TLS $y=$NC $pad_vla $NC${RED}│$NC $z RAM  $y=$NC $tram MB $NC"
echo -e " $NC$z TROJAN/GRPC  $y=$NC $pad_trb $NC${z}│$NC $z CPU  $y=$NC $CORE${NC}"
echo -e " $NC$z SHADOWSOCKS  $y=$NC $pad_ssa $NC${green}│$NC $z DATE $y=$NC $DATEVPS${NC}"
print_yellow "══════════════════════════════════════════════════════════"
echo -e "              ${purple}INFORMATION SERVICE ON VPS${NC}              "
print_yellow "══════════════════════════════════════════════════════════"

# FUNGSI CERDAS UNTUK PENYESUAIAN SPASI NAMA SERVICE
get_padded_name() {
    local name="$1"
    local len=${#name}
    local pad=$(( 9 - len ))
    local spaces=""
    for ((p=0; p<pad; p++)); do spaces+=" "; done
    REPLY_NAME="${name}${spaces}"
}

# === FORMAT TABEL SERVICE DINAMIS & PADAT ===
# Mengumpulkan semua layanan yang aktif
srv_names=("SSH" "NGINX" "XRAY" "WS-ePRO" "DROPBEAR" "HAPROXY")
srv_status=("$status_ssh" "$status_nginx" "$status_xray" "$ssh_ws_status" "$status_dropbear" "$status_haproxy")

if $is_zivpn; then srv_names+=("ZIVPN"); srv_status+=("$status_zivpn"); fi
if $is_udp; then srv_names+=("UDP-CSTM"); srv_status+=("$status_udp_custom"); fi
if $is_slowdns; then srv_names+=("SLOWDNS"); srv_status+=("$status_slowdns"); fi

# Mencetak tabel per 3 kolom dengan rapi dari kiri ke kanan
for ((i=0; i<${#srv_names[@]}; i+=3)); do
    get_padded_name "${srv_names[$i]}"
    c1=" ${y}${REPLY_NAME}${NC}: ${srv_status[$i]}    "

    if [[ $((i+1)) -lt ${#srv_names[@]} ]]; then
        get_padded_name "${srv_names[$i+1]}"
        c2="  ${y}${REPLY_NAME}${NC}: ${srv_status[$i+1]}      "
    else
        c2="                      "
    fi

    if [[ $((i+2)) -lt ${#srv_names[@]} ]]; then
        get_padded_name "${srv_names[$i+2]}"
        c3="  ${y}${REPLY_NAME}${NC}: ${srv_status[$i+2]}"
    else
        c3=""
    fi

    echo -e "${c1}${c2}${c3}"
done
# ============================================

print_yellow "══════════════════════════════════════════════════════════"
echo -e "                ${green}ALL FITUR SC TUNNELING${NC}                "
print_yellow "══════════════════════════════════════════════════════════"
echo -e "${z}$NC [${RED}01${NC}]$green MENU SSH$NC         $NC${y}│$NC  [${RED}06${NC}]$green MENU TRIAL$NC     ${z} $NC"
echo -e "${z}$NC [${RED}02${NC}]$green MENU VMESS$NC       $NC${Blue}│$NC  [${RED}07${NC}]$green SPEEDTEST$NC       ${z} $NC"
echo -e "${z}$NC [${RED}03${NC}]$green MENU VLESS$NC       $NC${RED}│$NC  [${RED}08${NC}]$green MENU UTILITY$NC   ${z} $NC"
echo -e "${z}$NC [${RED}04${NC}]$green MENU TROJAN$NC      $NC${green}│$NC  [${RED}10${NC}]$green CEK VPS$NC        ${z} $NC"

# === DAFTAR MENU DINAMIS PADAT ===
# Mengumpulkan menu tambahan yang aktif secara berurutan
active_ids=(5)
if $is_slowdns; then active_ids+=(11); fi
if $is_zivpn; then active_ids+=(12); fi
if $is_udp; then active_ids+=(13); fi

# Mencetak menu tambahan per 2 kolom dan memastikan garis lurus
for ((i=0; i<${#active_ids[@]}; i+=2)); do
    id_left=${active_ids[$i]}
    id_right=${active_ids[$i+1]}

    case $id_left in
        5) str_left="[${RED}05${NC}]${green} MENU SSWS${NC}        " ;;
        11) str_left="[${RED}11${NC}]${green} MENU SLOWDNS${NC}     " ;;
        12) str_left="[${RED}12${NC}]${green} MENU ZIVPN${NC}       " ;;
        13) str_left="[${RED}13${NC}]${green} MENU UDP${NC}         " ;;
    esac

    if [[ -z "$id_right" ]]; then
        str_right="                    " # Pengunci presisi 20 karakter jika kosong
    else
        case $id_right in
            11) str_right="[${RED}11${NC}]${green} MENU SLOWDNS${NC}   " ;;
            12) str_right="[${RED}12${NC}]${green} MENU ZIVPN${NC}     " ;;
            13) str_right="[${RED}13${NC}]${green} MENU UDP${NC}       " ;;
        esac
    fi

    echo -e "${z}$NC ${str_left}${NC}${y}│${NC}  ${str_right}${z} $NC"
done
# =================================

print_yellow "══════════════════════════════════════════════════════════"
echo -e ""
read -p " PILIH MENU DENGAN CARA KETIK ANGKA : " opt
echo -e ""
case $opt in
1 | 01) clear ; m-sshws ;;
2 | 02) clear ; m-vmess ;;
3 | 03) clear ; m-vless ;;
4 | 04) clear ; m-trojan ;;
5 | 05) clear ; m-ssws ;;
6 | 06) clear ; m-trial ;;
7 | 07) clear ; speedtest ;;
8 | 08) clear ; menu-x ;;
10 | 10) clear ; cek-vps ;;
11 | 11) clear ; menu-slowdns ;;
12 | 12) clear ; /usr/local/sbin/zivpn-menu ;;
13 | 13) clear ; menu-udp ;;
0 | 00) exit ;;
x) menu ;;
*) clear ; echo -e ; menu ;;
esac
